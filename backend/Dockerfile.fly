# ============================================================================
# ExamCraft AI Backend - Fly.io Production Dockerfile
# Multi-stage build for minimal image size and security
# ============================================================================

# =========================
# Stage 1: Build Stage
# =========================
FROM python:3.12-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
    libmupdf-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first (for better layer caching)
COPY core/backend/requirements.txt ./

# Install Python dependencies. requirements.txt itself needs no credentials
# (see its own comment on why specula-client isn't listed there).
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Optional: TF-865 observability (specula-client, private repo, not on PyPI
# yet, see requirements.txt). Only attempted when a GITHUB_TOKEN build secret
# is supplied (deploy.yml always supplies MIRROR_GITHUB_TOKEN here, so a real
# Fly.io deploy always gets it); config/observability.py and
# middleware/observability_context.py degrade to a fully functional,
# tracing-less no-op when the package isn't importable, so this stays a
# working image even in a build that somehow lacks the secret. This is also
# the mechanism a real (currently dormant) subscribeflow SDK private release
# would reuse.
#
# `-s` (not `-f`): BuildKit still mounts an EMPTY file at
# /run/secrets/GITHUB_TOKEN when the secret isn't supplied at all -- `-f`
# alone would be true for that empty file too, attempting an anonymous
# `https://@github.com/...` clone of a private repo (guaranteed to fail).
#
# The token is embedded directly in the pip install URL argument, not
# written to disk via `git config --global` -- nothing to clean up
# afterwards, and no risk of it persisting in a shipped image layer (this
# stage's layers are discarded anyway; the runtime stage below only copies
# the installed site-packages, not this stage's filesystem history).
RUN --mount=type=secret,id=GITHUB_TOKEN \
    if [ -s /run/secrets/GITHUB_TOKEN ]; then \
        GITHUB_TOKEN=$(cat /run/secrets/GITHUB_TOKEN) && \
        pip install --no-cache-dir "specula-client[fastapi,celery] @ git+https://${GITHUB_TOKEN}@github.com/talent-factory/specula-client-python.git@v0.1.0"; \
    fi

# =========================
# Stage 2: Runtime Stage
# =========================
FROM python:3.12-slim AS runtime

# Install runtime dependencies
# Tesseract (+ deu/eng) enables PyMuPDF OCR escalation for scanned PDFs/DOCX
# (TF-360). Without it is_ocr_available() returns False and the escalation
# silently lands on escalation="unavailable" — OCR never runs in prod (TF-380).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libmagic1 \
    libmupdf-dev \
    mupdf \
    curl \
    tesseract-ocr \
    tesseract-ocr-deu \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# PyMuPDFs get_textpage_ocr verlangt eine gesetzte TESSDATA_PREFIX. Pfad ist
# nach Tesseract-Major-Version versioniert (aktuell 5.x), nicht nach Debian-
# Codename (python:3.12-slim zeigt inzwischen auf Debian Trixie statt
# Bookworm, ohne dass sich dieser Pfad geändert hätte -- empirisch verifiziert,
# TF-865). Bei abweichender Tesseract-Major-Version anpassen. Identisch zum
# lokalen core/backend/Dockerfile.
ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Create non-root user for security
RUN groupadd --gid 1000 appgroup \
    && useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

# Set working directory
WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY core/backend/ ./

# Copy Premium package (for Full deployment mode)
# Directory is created by CI if submodule checkout fails, so COPY always succeeds
COPY premium/backend/ ./premium/

# Copy utils directory (RAG, extraction modules)
COPY core/utils/ ./utils/

# Copy docs-site for startup auto-indexing.
# DocsIndexerService reads DOCS_SITE_PATH=/app/docs-site/docs on backend startup
# and re-indexes all markdown files into Qdrant collection "docs_help".
COPY core/docs-site/ ./docs-site/

# Copy entrypoint script
COPY core/backend/docker-entrypoint.sh ./docker-entrypoint.sh

# Create necessary directories
RUN mkdir -p storage/uploads mock_vector_db

# Set ownership and make entrypoint executable
RUN chown -R appuser:appgroup /app && chmod +x /app/docker-entrypoint.sh

# Switch to non-root user
USER appuser

# Environment variables
ENV PYTHONPATH="/app:/app/utils:$PYTHONPATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl --fail http://localhost:8000/api/v1/health || exit 1

# Entrypoint runs migrations before starting
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Production command: single worker to stay within 1GB RAM
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
